// On-device inference workers exposed as catalog models.

provider "local" {
	default-model "lfm2.5-230m"
	allow-unauthenticated #true

	seed api="local-inference" base-url="local://inference" bundle="always" {
		model "kokoro" name="Kokoro-82M" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "parakeet-tdt-0.6b-v3" name="Parakeet TDT 0.6B v3" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "nemotron-streaming-en-0.6b" name="Nemotron Speech 0.6B (Streaming English)" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "whisper-base" name="Whisper Base" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "whisper-small" name="Whisper Small" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "whisper-large-v3-turbo" name="Whisper Large v3 Turbo" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "lfm2.5-230m" name="LFM2.5 230M" description="Recommended local model; fastest LFM2.5 option, about 214 MB cached." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "lfm2.5-350m" name="LFM2.5 350M" description="Larger LFM2.5 option, about 292 MB cached; tends toward terse titles." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "falcon-h1-90m" name="Falcon H1 Tiny 90M" description="Smallest option, about 147 MB cached; lower fidelity on complex prompts." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "qwen3-1.7b" name="Qwen3 1.7B" description="MLX only (providers.tinyModelDevice=mlx): onnxruntime-node cannot run this ONNX export's RotaryEmbedding cache updates." {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "llama3.2:3b" name="Llama 3.2 3B" description="Larger Llama 3.2 option for local memory/classifier tasks; higher quality potential at higher disk/RAM/latency cost." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "gemma-3-1b" name="Gemma 3 1B" description="Best consolidation/dedup; lighter footprint, but leaks small talk during extraction." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "qwen2.5-1.5b" name="Qwen2.5 1.5B" description="Best extraction granularity (atomic facts); weaker consolidation." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "lfm2-1.2b" name="LFM2 1.2B" description="Fastest load; solid all-rounder, slightly noisier extraction labels." {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
	}

	models "kokoro" {
		kind "tts"
	}
	models "parakeet-tdt-0.6b-v3" "nemotron-streaming-en-0.6b" "whisper-*" {
		kind "stt"
	}
	models "lfm*" "falcon-*" "qwen*" "llama3.2:3b" "gemma-3-1b" {
		kind "tiny"
	}
}
