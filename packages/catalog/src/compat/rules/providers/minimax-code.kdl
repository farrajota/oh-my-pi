// Provider-wire compat for "minimax-code"; regenerated from the frozen census using deployment contract selectors.

provider "minimax-code" priority=1 {
	default-model "MiniMax-M3"
	env "MINIMAX_CODE_API_KEY"

	on-api "openai-completions" {
		// Baked Code rows still use the legacy OpenAI-compatible route.
		thinking-mode "effort"
		models "MiniMax-M2.1-lightning" "MiniMax-M2.5-lightning" {
			thinking-mode "effort"
		}
		// Legacy completion rows keep the original four-tier Code ladder.
		models "MiniMax-M3" "MiniMax-M3.1-Flash-Preview" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
}
