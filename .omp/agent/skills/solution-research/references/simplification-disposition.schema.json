{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/schemas/simplification-disposition.schema.json",
  "title": "Simplification disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic_id",
    "frame_revision",
    "candidate_id",
    "disposition",
    "recheck_categories"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "topic_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?-[0-9a-f]{12}(?:-[1-9]|-1[0-9]|-20|-[0-9]{8}T[0-9]{6}Z)?$"
    },
    "frame_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "NO_SIMPLER_CHANGE",
        "INLINE_SIMPLIFICATION",
        "SCRIPT_COMPONENT_ONLY",
        "SCRIPT_PRIMARY",
        "MORE_EVIDENCE_REQUIRED",
        "NOT_APPLICABLE",
        "BLOCKED"
      ]
    },
    "recheck_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "frame",
          "mechanism",
          "correctness",
          "security",
          "state-concurrency",
          "decisive-evidence"
        ]
      }
    }
  }
}
