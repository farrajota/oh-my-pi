{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omp://skill-cutover/baseline-source.schema.json",
  "title": "Skill cutover baseline source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_kind", "fork_revision", "identities", "owned_tree_sha256", "manifest"],
  "properties": {
    "schema_version": {"const": 1},
    "source_kind": {"const": "active-predecessor"},
    "fork_revision": {"type": "string", "minLength": 1},
    "identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owned_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest": {"type": "object"}
  }
}
